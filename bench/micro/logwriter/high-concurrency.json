{
 "mechanism": "log writer threads",
 "role": "positive",
 "claim": "With hundreds of concurrent durable commits, dedicated log writer threads group redo writes and syncs: ON does not lose, and syncs per transaction fall.",
 "dataset": {
  "tables": 8,
  "rows": 4000000
 },
 "fixed": {},
 "workload": {
  "test": "oltp_update_non_index",
  "threads": 512,
  "rand": "uniform"
 },
 "warmup": 300,
 "duration": 300,
 "goal": "tps",
 "sweep": {
  "variable": "innodb_log_writer_threads",
  "values": [
   "OFF",
   "ON"
  ]
 },
 "repeats": 2,
 "expect": [
  {
   "kind": "response",
   "from": "OFF",
   "to": "ON",
   "metric": "tps",
   "direction": "not_down"
  },
  {
   "kind": "response",
   "from": "OFF",
   "to": "ON",
   "metric": "trx:Innodb_os_log_fsyncs",
   "direction": "down",
   "min_pct": 10
  }
 ]
}