{
 "mechanism": "innodb_buffer_pool_instances",
 "role": "negative",
 "claim": "At low concurrency the buffer pool latches are not contended: more instances change nothing.",
 "dataset": {
  "tables": 8,
  "rows": 1000000
 },
 "fixed": {
  "innodb_buffer_pool_size": "12G"
 },
 "workload": {
  "test": "oltp_point_select",
  "threads": 8,
  "rand": "pareto"
 },
 "warmup": 300,
 "duration": 300,
 "goal": "tps",
 "sweep": {
  "variable": "innodb_buffer_pool_instances",
  "values": [
   "1",
   "8"
  ]
 },
 "repeats": 2,
 "expect": [
  {
   "kind": "response",
   "from": "1",
   "to": "8",
   "metric": "tps",
   "direction": "flat",
   "max_pct": 3
  }
 ]
}