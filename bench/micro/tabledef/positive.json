{
 "mechanism": "table_definition_cache",
 "role": "positive",
 "claim": "With 4,000 tables and a 400-entry definition cache, table definitions are evicted and reloaded from the data dictionary; a large cache raises throughput.",
 "dataset": {
  "tables": 4000,
  "rows": 1000
 },
 "fixed": {
  "table_open_cache": "8000",
  "open_files_limit": "65535"
 },
 "workload": {
  "test": "oltp_point_select",
  "threads": 64,
  "rand": "uniform"
 },
 "warmup": 180,
 "duration": 300,
 "goal": "tps",
 "sweep": {
  "variable": "table_definition_cache",
  "values": [
   "400",
   "8000"
  ]
 },
 "repeats": 2,
 "expect": [
  {
   "kind": "response",
   "from": "400",
   "to": "8000",
   "metric": "tps",
   "direction": "up",
   "min_pct": 3
  },
  {
   "kind": "signal",
   "at": "400",
   "metric": "st:Opened_table_definitions",
   "op": ">=",
   "value": 10
  }
 ]
}