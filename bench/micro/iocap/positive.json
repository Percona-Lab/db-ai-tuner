{
 "mechanism": "innodb_io_capacity",
 "role": "positive",
 "claim": "When InnoDB asks to flush more pages than innodb_io_capacity allows and the disk has room, the cap holds flushing back: raising it raises throughput.",
 "dataset": {
  "tables": 8,
  "rows": 16000000
 },
 "fixed": {
  "innodb_buffer_pool_size": "4G",
  "innodb_flush_log_at_trx_commit": "2"
 },
 "workload": {
  "test": "oltp_update_non_index",
  "threads": 64,
  "rand": "uniform"
 },
 "warmup": 600,
 "duration": 300,
 "goal": "tps",
 "sweep": {
  "variable": "innodb_io_capacity",
  "values": [
   "200",
   "2000",
   "10000"
  ]
 },
 "repeats": 2,
 "expect": [
  {
   "kind": "response",
   "from": "200",
   "to": "2000",
   "metric": "tps",
   "direction": "up",
   "min_pct": 5
  },
  {
   "kind": "signal",
   "at": "200",
   "metric": "flush_requested_vs_capacity",
   "op": ">=",
   "value": 1
  }
 ]
}