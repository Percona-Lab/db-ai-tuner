{
 "mechanism": "innodb_lru_scan_depth",
 "role": "negative",
 "claim": "With the data in memory there are always free pages: the scan depth changes nothing.",
 "dataset": {
  "tables": 8,
  "rows": 4000000
 },
 "fixed": {
  "innodb_buffer_pool_size": "12G"
 },
 "workload": {
  "test": "oltp_read_write",
  "threads": 64,
  "rand": "uniform"
 },
 "warmup": 300,
 "duration": 300,
 "goal": "tps",
 "sweep": {
  "variable": "innodb_lru_scan_depth",
  "values": [
   "128",
   "4096"
  ]
 },
 "repeats": 2,
 "expect": [
  {
   "kind": "response",
   "from": "128",
   "to": "4096",
   "metric": "tps",
   "direction": "flat",
   "max_pct": 3
  }
 ]
}