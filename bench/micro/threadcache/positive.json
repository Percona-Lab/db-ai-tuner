{
 "mechanism": "thread_cache_size",
 "role": "positive",
 "claim": "When every transaction opens a new connection, each connect creates a thread unless one is cached; a thread cache raises throughput.",
 "dataset": {
  "tables": 8,
  "rows": 1000000
 },
 "fixed": {},
 "workload": {
  "test": "/root/bench/micro/lua/connstorm.lua",
  "threads": 64,
  "rand": "uniform"
 },
 "warmup": 300,
 "duration": 300,
 "goal": "tps",
 "sweep": {
  "variable": "thread_cache_size",
  "values": [
   "0",
   "128"
  ]
 },
 "repeats": 2,
 "expect": [
  {
   "kind": "response",
   "from": "0",
   "to": "128",
   "metric": "tps",
   "direction": "up",
   "min_pct": 5
  },
  {
   "kind": "signal",
   "at": "0",
   "metric": "st:Threads_created",
   "op": ">=",
   "value": 100
  }
 ]
}