{
 "mechanism": "binlog group commit delay",
 "role": "positive",
 "claim": "With the binary log on and synced at every group, a short group commit delay gathers more transactions per sync: binlog syncs per transaction fall.",
 "dataset": {
  "tables": 8,
  "rows": 4000000
 },
 "fixed": {
  "sync_binlog": "1"
 },
 "workload": {
  "test": "oltp_update_non_index",
  "threads": 128,
  "rand": "uniform"
 },
 "warmup": 300,
 "duration": 300,
 "goal": "tps",
 "sweep": {
  "variable": "binlog_group_commit_sync_delay",
  "values": [
   "0",
   "1000"
  ]
 },
 "repeats": 2,
 "expect": [
  {
   "kind": "response",
   "from": "0",
   "to": "1000",
   "metric": "binlog_syncs_per_trx",
   "direction": "down",
   "min_pct": 30
  },
  {
   "kind": "response",
   "from": "0",
   "to": "1000",
   "metric": "tps",
   "direction": "not_down"
  }
 ]
}